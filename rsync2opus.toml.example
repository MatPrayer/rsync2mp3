# rsync2opus configuration
#
# Copy this file to rsync2opus.toml (or ~/.config/rsync2opus/config.toml) and
# edit the values below.
#
# Looked up in this order, first hit wins:
#   1. --config PATH
#   2. ./rsync2opus.toml
#   3. ~/.config/rsync2opus/config.toml
#
# Command-line flags always override whatever is set here.

# Default endpoints, so `rsync2opus sync` works with no arguments.
source = "user@host:path/to/music"
dest = "/path/to/music-opus"

# Opus target bitrate for stereo. Scaled up automatically for surround.
bitrate = "128k"

# Bitrate mode: "on" (default), "constrained", or "off" for a true CBR stream.
# With vbr on, `bitrate` is a target rather than a ceiling.
# vbr = "on"

# Encoder effort, 0 (fastest) to 10 (best, the default). Buys quality at the
# cost of encoding time — it does not change the file size.
# compression_level = 10

# Skip audio longer than this outright — not converted, not copied, and never
# deleted by `reclaim`. Accepts 25m, 1h30m, 90s, or bare seconds.
# Costs one ffprobe per audio file, so leave it unset if you don't need it.
max_duration = "25m"

# Long-form music that is not a DJ mix. These are exempt from max_duration,
# so they survive both `sync` and `prune`. Each entry is matched first as a
# literal relative path, then as a glob.
keep_long = [
  # "Artist/Album/01 - Long Track.opus",
  # "Artist/*/*Another Long Track.opus",
]

# Embed cover art in each .opus file.
art = true

# Parallel workers. Defaults to your core count, capped at 24.
# jobs = 24

# Remove destination files whose source is gone.
# delete = false

# Allowed duration drift in seconds when verifying.
# tolerance = 1.0

# SSH port for remote endpoints.
# port = 22

# Shared configuration for rsync2mp3, rsync2opus and rsync2aac.
#
# Copy this file to config.toml (or ~/.config/rsync2/config.toml) and edit the
# values below.
#
# Looked up in this order, first hit wins:
#   1. --config PATH
#   2. ./config.toml
#   3. $XDG_CONFIG_HOME/rsync2/config.toml, if that variable is set
#   4. ~/Library/Application Support/rsync2/config.toml (macOS only)
#   5. ~/.config/rsync2/config.toml
#
# Keys at the top level apply to all three tools. The [mp3], [opus] and [aac]
# tables override them, and are where anything codec-specific belongs.
# Command-line flags always override whatever is set here.


# --- shared -------------------------------------------------------------------

# Default source, so `rsync2mp3 sync` works with no arguments. Each tool needs
# its own `dest`, so that one lives in the tables below.
source = "user@host:path/to/music"

# Skip audio longer than this outright — not converted, not copied, and never
# deleted by `reclaim`. Accepts 25m, 1h30m, 90s, or bare seconds.
# Costs one ffprobe per audio file, so leave it unset if you don't need it.
max_duration = "25m"

# Embed cover art in each output file.
art = true

# Parallel workers. Defaults to your core count, capped at 24.
# jobs = 24

# Remove destination files whose source is gone.
# delete = false

# Allowed duration drift in seconds when verifying.
# tolerance = 1.0

# SSH port for remote endpoints.
# port = 22


# --- rsync2mp3 ----------------------------------------------------------------

[mp3]
dest = "/path/to/music-mp3"

# Constant bitrate for the encode. Ignored when `vbr` is set.
bitrate = "256k"

# LAME VBR quality, 0 (best) to 9 (worst). Smaller files than CBR at the same
# quality; use it unless the target player chokes on VBR mp3.
# vbr = 0

# LAME's -q: encoder search effort, 0 (best, slowest) to 9 (fastest). Affects
# how hard the encoder looks, not the bitrate it lands on.
# compression_level = 0

# Long-form music that is not a DJ mix. These are exempt from max_duration, so
# they survive both `sync` and `prune`. Each entry is matched first as a
# literal relative path, then as a glob. They name *destination* paths, which
# is why each table spells the same track with its own extension.
keep_long = [
  # "Artist/Album/01 - Long Track.mp3",
  # "Artist/*/*Another Long Track.mp3",
]


# --- rsync2opus ---------------------------------------------------------------

[opus]
dest = "/path/to/music-opus"

# Opus target bitrate for stereo. Scaled up automatically for surround.
bitrate = "128k"

# Bitrate mode: "on" (default), "constrained", or "off" for a true CBR stream.
# With vbr on, `bitrate` is a target rather than a ceiling.
# vbr = "on"

# Encoder effort, 0 (fastest) to 10 (best, the default). Buys quality at the
# cost of encoding time — it does not change the file size.
# compression_level = 10

keep_long = [
  # "Artist/Album/01 - Long Track.opus",
  # "Artist/*/*Another Long Track.opus",
]


# --- rsync2aac ----------------------------------------------------------------

[aac]
dest = "/path/to/music-aac"

# AAC bitrate. 192k with libfdk_aac is roughly 256k with the native encoder.
bitrate = "192k"

# Encoder: "auto" picks libfdk_aac when this ffmpeg has it, else the native
# one. Force with "libfdk_aac" or "aac".
encoder = "auto"

# VBR quality instead of a fixed bitrate, 1 (worst) to 5 (best). 4 lands
# around 192 kbps. Overrides `bitrate`.
# vbr = 4

# Write the tags MP4 has no atom for (ReplayGain, label, release date) as
# freeform atoms, instead of letting ffmpeg drop them.
tags = true

keep_long = [
  # "Artist/Album/01 - Long Track.m4a",
  # "Artist/*/*Another Long Track.m4a",
]

# rsync2aac configuration
#
# Copy this file to rsync2aac.toml (or ~/.config/rsync2aac/config.toml) and
# edit the values below.
#
# Looked up in this order, first hit wins:
#   1. --config PATH
#   2. ./rsync2aac.toml
#   3. ~/.config/rsync2aac/config.toml
#
# Command-line flags always override whatever is set here.

# Default endpoints, so `rsync2aac sync` works with no arguments.
source = "user@host:path/to/music"
dest = "/path/to/music-aac"

# --- audio quality ------------------------------------------------------------

# Constant bitrate for the encode. Ignored when `vbr` is set.
bitrate = "192k"

# VBR quality, 1 (worst) to 5 (best). 4 lands around 192 kbps. Smaller files
# than CBR at the same quality; drop it if the target player mistracks VBR.
# vbr = 4

# Which AAC encoder: "auto", "libfdk_aac" or "aac". auto takes libfdk_aac when
# this ffmpeg has it — it is clearly better, but its licence keeps it out of
# most distro builds — and falls back to ffmpeg's own encoder otherwise.
encoder = "auto"

# --- what gets carried across ---------------------------------------------------

# Embed cover art in each .m4a as the MP4 `covr` atom.
art = true

# Carry tags that MP4 has no atom for — ReplayGain, label, ISRC, MusicBrainz
# ids, track/disc totals — into iTunes-style freeform atoms. Costs nothing
# extra: the probe it needs is the one the art pass already does.
tags = true

# --- everything else ------------------------------------------------------------

# Skip audio longer than this outright — not converted, not copied, and never
# deleted by `reclaim`. Accepts 25m, 1h30m, 90s, or bare seconds.
# Costs one ffprobe per audio file, so leave it unset if you don't need it.
max_duration = "25m"

# Long-form music that is not a DJ mix. These are exempt from max_duration,
# so they survive both `sync` and `prune`. Each entry is matched first as a
# literal relative path, then as a glob.
keep_long = [
  # "Artist/Album/01 - Long Track.m4a",
  # "Artist/*/*Another Long Track.m4a",
]

# Parallel workers. Defaults to your core count, capped at 24.
# jobs = 24

# Remove destination files whose source is gone.
# delete = false

# Allowed duration drift in seconds when verifying.
# tolerance = 1.0

# SSH port for remote endpoints.
# port = 22
